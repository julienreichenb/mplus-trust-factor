{
  "name": "@mplus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "tsx src/openapi-generate.ts",
    "e2e:fixture-api": "tsx src/e2e-fixture-server.ts",
    "ability-catalog:review:import": "tsx src/cli/review-import.ts",
    "ability-catalog:dev:reset": "tsx src/cli/dev-reset-ability-catalog.ts",
    "ability-catalog:baseline:export": "tsx src/cli/baseline-export.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@mplus/abilities": "workspace:*",
    "@mplus/config": "workspace:*",
    "@mplus/contracts": "workspace:*",
    "@mplus/database": "workspace:*",
    "@mplus/domain": "workspace:*",
    "@mplus/observability": "workspace:*",
    "@mplus/provider-blizzard": "workspace:*",
    "@mplus/provider-warcraftlogs": "workspace:*",
    "@mplus/scoring": "workspace:*",
    "@mplus/test-utils": "workspace:*",
    "@mplus/worker": "workspace:*",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
