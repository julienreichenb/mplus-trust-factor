{
  "name": "@mplus/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/public-api.ts",
  "types": "./src/public-api.ts",
  "exports": {
    ".": "./src/public-api.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "realms:sync": "tsx ../../tools/scripts/sync-realm-catalog.mjs",
    "season:sync-authority": "tsx src/orchestration/sync-season-authority.cli.ts",
    "scoring:canary": "tsx src/orchestration/scoring/public-cli.ts canary",
    "scoring:replay": "tsx src/orchestration/scoring/public-cli.ts replay",
    "scoring:doctor": "tsx src/orchestration/scoring/public-cli.ts doctor",
    "scoring:smoke:character": "tsx src/orchestration/scoring/smoke-character.cli.ts",
    "scoring:diagnose:stabilization": "tsx src/orchestration/scoring/stabilization-diagnostic.cli.ts",
    "utility:trace-character": "tsx src/orchestration/scoring/utility-character-trace.cli.ts",
    "experience:cutoffs:collect": "tsx src/orchestration/scoring/experience-cutoffs-collect.cli.ts",
    "scoring:validate:digest-backfill": "tsx src/orchestration/scoring/live-digest-backfill-validate.cli.ts",
    "boost:probe": "tsx src/boost-assessment/probe.cli.ts",
    "boost:population-audit": "tsx src/boost-assessment/population-audit.cli.ts",
    "wcl:hydrate:rankings": "tsx src/wcl-fight-rankings/hydrate-rankings.cli.ts",
    "canary:internal": "tsx src/orchestration/scoring/canary/cli.ts"
