  "dependencies": {
    "@mplus/artifact-store": "workspace:*",
    "@mplus/config": "workspace:*",
    "@mplus/contracts": "workspace:*",
    "@mplus/database": "workspace:*",
    "@mplus/domain": "workspace:*",
    "@mplus/observability": "workspace:*",
    "@mplus/addon-exporter": "workspace:*",
    "@mplus/abilities": "workspace:*",
    "@mplus/mechanics": "workspace:*",
    "@mplus/provider-blizzard": "workspace:*",
    "@mplus/provider-warcraftlogs": "workspace:*",
    "@mplus/provider-raiderio": "workspace:*",
    "@mplus/scoring": "workspace:*",
    "@mplus/test-utils": "workspace:*",
    "bullmq": "^5.56.4",
    "ioredis": "^5.6.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
