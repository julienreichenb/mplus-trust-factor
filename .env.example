# Application
NODE_ENV=development
APP_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
TZ=UTC

# Database / queue
DATABASE_URL=postgresql://mplus:mplus@localhost:5433/mplus_trust?schema=public
REDIS_URL=redis://localhost:6379
RAW_ARTIFACTS_DIR=./data/raw-artifacts
RAW_ARTIFACT_RETENTION_DAYS=30

# Provider mode: fixture | live
# Fixture mode starts without live credentials.
PROVIDER_MODE=fixture

# Manual live smoke opt-in only. Never set true in CI.
ALLOW_LIVE_PROVIDER_CALLS=false

# Per-provider enable flags (credentials validated only when PROVIDER_MODE=live and enabled)
BLIZZARD_ENABLED=true
WCL_ENABLED=true
RAIDERIO_ENABLED=true

# Blizzard (required only when PROVIDER_MODE=live and BLIZZARD_ENABLED=true)
# Server-only — never put these in VITE_* variables.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_DEFAULT_REGION=eu
BLIZZARD_DEFAULT_LOCALE=en_GB
BLIZZARD_REQUEST_CONCURRENCY=4
BLIZZARD_CHARACTER_TTL_SECONDS=86400

# Warcraft Logs (required only when PROVIDER_MODE=live and WCL_ENABLED=true)
# Server-only — never put these in VITE_* variables.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_PUBLIC_GRAPHQL_URL=https://www.warcraftlogs.com/api/v2/client
WCL_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
WCL_RATE_WARN_PERCENT=70
WCL_RATE_DEFER_PERCENT=80
WCL_RATE_STOP_PERCENT=90
WCL_CHARACTER_TTL_SECONDS=43200
WCL_MPLUS_ZONE_ID=47
# Recommended ISO expiry for the configured M+ zone mapping (do not invent a date in code).
# When unset, the worker logs a warning. When past expiry, zone rankings are skipped.
# WCL_MPLUS_ZONE_EXPIRES_AT=

# Raider.IO (app key optional; improves rate limits when approved)
# Server-only — never put these in VITE_* variables.
RAIDERIO_BASE_URL=https://raider.io
RAIDERIO_APP_KEY=
RAIDERIO_SOFT_RPM=60
RAIDERIO_REQUEST_CONCURRENCY=2
RAIDERIO_CHARACTER_TTL_SECONDS=43200
RAIDERIO_NEGATIVE_CACHE_SECONDS=2700
RAIDERIO_CUTOFFS_TTL_SECONDS=86400
RAIDERIO_STATIC_DATA_TTL_SECONDS=604800

# Scoring
ACTIVE_SCORE_MODEL_KEY=default
ACTIVE_SCORE_MODEL_VERSION=2
MANUAL_REFRESH_COOLDOWN_SECONDS=900

# Admin / auth (local MVP)
ADMIN_API_KEY=local-dev-admin-key-change-me
SESSION_SECRET=local-dev-session-secret-change-me-32chars
COOKIE_DOMAIN=localhost
TRUST_PROXY=false

# Production / deployment placeholders (Agent 8)
DOMAIN=
ACME_EMAIL=
GHCR_OWNER=
IMAGE_TAG=local
POSTGRES_DB=mplus_trust
POSTGRES_USER=mplus
POSTGRES_PASSWORD=mplus
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14
