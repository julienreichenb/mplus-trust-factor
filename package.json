{
  "name": "mplus-trust-factor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "M+ Trust Factor — explainable Mythic+ trust scores from public data",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:data-quality": "vitest run tests/data-quality",
    "test:security": "vitest run tests/security",
    "test:failure": "vitest run tests/failure-injection",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter @mplus/web run test:e2e",
    "test:load": "node tools/scripts/load-test.mjs",
    "build": "node tools/scripts/clean-dist.mjs && pnpm -r --if-present run build",
    "clean:dist": "node tools/scripts/clean-dist.mjs",
    "dev": "node tools/scripts/with-env.mjs pnpm run --parallel --filter @mplus/api --filter @mplus/worker --filter @mplus/web dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec prisma migrate deploy",
    "db:migrate:dev": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec prisma migrate dev",
    "db:seed": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database run seed",
    "db:studio": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec prisma studio",
    "db:generate": "pnpm --filter @mplus/database exec prisma generate",
    "openapi:generate": "node tools/scripts/with-env.mjs pnpm --filter @mplus/api run openapi:generate",
    "addon:export": "node tools/scripts/addon.mjs export",
    "addon:test": "node tools/scripts/addon.mjs test",
    "addon:check": "node tools/scripts/addon.mjs check",
    "addon:benchmark": "node tools/scripts/addon.mjs benchmark",
    "addon:package": "node tools/scripts/addon.mjs package",
    "wcl:smoke": "node tools/scripts/with-env.mjs node tools/scripts/wcl-smoke.mjs",
    "blizzard:smoke": "node tools/scripts/with-env.mjs pnpm --filter @mplus/provider-blizzard smoke:live",
    "live:smoke:blizzard": "node tools/scripts/with-env.mjs node tools/scripts/live-smoke-blizzard.mjs",
    "live:smoke:raiderio": "node tools/scripts/with-env.mjs node tools/scripts/live-smoke-raiderio.mjs",
    "live:smoke:wcl": "node tools/scripts/with-env.mjs node tools/scripts/live-smoke-wcl.mjs",
    "live:smoke:character": "node tools/scripts/with-env.mjs node tools/scripts/live-smoke-character.mjs",
    "realms:sync": "node tools/scripts/with-env.mjs node tools/scripts/sync-realm-catalog.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "autocannon": "^8.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  }
}
