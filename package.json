{
  "name": "mplus-trust-factor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "M+ Trust Factor — explainable Mythic+ trust scores from public data",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "bootstrap": "node tools/scripts/bootstrap.mjs",
    "test": "node tools/scripts/run-tests-isolated.mjs --seed -- pnpm exec vitest run",
    "test:raw": "pnpm exec vitest run",
    "check:english": "pnpm --filter @mplus/web check:english",
    "test:contract": "node tools/scripts/run-tests-isolated.mjs --seed -- pnpm exec vitest run tests/contract",
    "test:data-quality": "node tools/scripts/run-tests-isolated.mjs --seed -- pnpm exec vitest run tests/data-quality",
    "test:security": "node tools/scripts/run-tests-isolated.mjs --seed -- pnpm exec vitest run tests/security",
    "test:failure": "node tools/scripts/run-tests-isolated.mjs --seed -- pnpm exec vitest run tests/failure-injection",
    "test:integration:shared": "node tools/scripts/run-tests-isolated.mjs --seed -- pnpm exec vitest run --config vitest.integration.config.ts",
    "test:integration:destructive": "node tools/scripts/run-tests-isolated.mjs --seed -- pnpm exec vitest run --config vitest.integration.destructive.config.ts",
    "test:integration": "pnpm run test:integration:shared && pnpm run test:integration:destructive",
    "test:e2e": "pnpm --filter @mplus/web run test:e2e",
    "test:load": "node tools/scripts/load-test.mjs",
    "build": "node tools/scripts/clean-dist.mjs && pnpm -r --if-present run build",
    "clean:dist": "node tools/scripts/clean-dist.mjs",
    "dev": "node tools/scripts/with-env.mjs pnpm run --parallel --filter @mplus/api --filter @mplus/worker --filter @mplus/web dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec prisma migrate deploy",
    "db:migrate:dev": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec prisma migrate dev",
    "db:seed": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database run seed",
    "db:studio": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec prisma studio",
    "db:generate": "pnpm --filter @mplus/database exec prisma generate",
    "db:reset:scoring": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec tsx src/reset/cli-test-reset.ts",
    "db:reset:wcl-scoring-derived": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec tsx src/reset/cli-wcl-scoring-derived-reset.ts",
    "db:reset:identity-data": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec tsx src/reset/cli-identity-data-reset.ts",
    "db:calibration-labels:export": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec tsx src/reset/cli-calibration-labels.ts export",
    "db:calibration-labels:import": "node tools/scripts/with-env.mjs pnpm --filter @mplus/database exec tsx src/reset/cli-calibration-labels.ts import",
    "db:cleanup:test-artifacts": "node tools/scripts/with-env.mjs node tools/scripts/cleanup-test-artifacts.mjs",
    "db:cleanup:test-score-models": "node tools/scripts/cleanup-test-score-models.mjs",
    "db:backfill:character-name-search-key": "node tools/scripts/with-env.mjs node tools/scripts/backfill-character-name-search-key.mjs",
    "openapi:generate": "node tools/scripts/with-env.mjs pnpm --filter @mplus/api run openapi:generate",
    "addon:export": "node tools/scripts/addon.mjs export",
    "addon:test": "node tools/scripts/addon.mjs test",
    "addon:check": "node tools/scripts/addon.mjs check",
    "addon:benchmark": "node tools/scripts/addon.mjs benchmark",
    "addon:package": "node tools/scripts/addon.mjs package",
    "wcl:smoke": "node tools/scripts/with-env.mjs node tools/scripts/wcl-smoke.mjs",
    "blizzard:smoke": "node tools/scripts/with-env.mjs pnpm --filter @mplus/provider-blizzard smoke:live",
    "calibration:cohort-enrich": "node tools/scripts/with-env.mjs pnpm --filter @mplus/api exec tsx src/services/calibration/cohort-enrichment-cli.ts",
    "calibration:reapply-role-context": "pnpm --filter @mplus/api exec tsx src/services/calibration/reapply-role-context-cli.ts",
    "calibration:evidence-join": "pnpm --filter @mplus/api exec tsx src/services/calibration/evidence-join-readonly-cli.ts",
    "calibration:cohort-bootstrap": "node tools/scripts/with-env.mjs pnpm --filter @mplus/api exec tsx src/services/calibration/cohort-bootstrap-cli.ts",
    "calibration:cohort-import": "node tools/scripts/with-env.mjs pnpm --filter @mplus/api exec tsx src/services/calibration/cohort-import-cli.ts",
    "live:smoke:blizzard": "node tools/scripts/with-env.mjs node tools/scripts/live-smoke-blizzard.mjs",
    "live:smoke:raiderio": "node tools/scripts/with-env.mjs node tools/scripts/live-smoke-raiderio.mjs",
    "live:smoke:wcl": "node tools/scripts/with-env.mjs node tools/scripts/live-smoke-wcl.mjs",
    "live:smoke:character": "node tools/scripts/with-env.mjs node tools/scripts/live-smoke-character.mjs",
    "wcl:probe:performance": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-performance.mjs",
    "wcl:probe:survival": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-survival.mjs",
    "wcl:probe:survival:calibration": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-survival-calibration.mjs",
    "wcl:probe:utility": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-utility.mjs",
    "wcl:probe:utility:v1": "node tools/scripts/wcl-probe-utility-v1.mjs",
    "wcl:probe:utility:v2-audit": "node tools/scripts/wcl-probe-utility-v2-audit.mjs",
    "wcl:probe:utility:v3-simulation": "node tools/scripts/wcl-probe-utility-v3-simulation.mjs",
    "wcl:probe:utility:v3_1-calibration": "node tools/scripts/wcl-probe-utility-v3_1-calibration.mjs",
    "wcl:probe:utility:v3_2-calibration": "node tools/scripts/wcl-probe-utility-v3_2-calibration.mjs",
    "wcl:shared-evidence:load": "node tools/scripts/with-env.mjs node tools/scripts/wcl-shared-evidence-load.mjs",
    "wcl:probe:planner": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-planner.mjs",
    "wcl:probe:utility:cross-class-validate": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-utility-cross-class.mjs",
    "wcl:probe:survival:v1": "node tools/scripts/wcl-probe-survival-v1.mjs",
    "wcl:probe:survival:v1.1": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-survival-v1_1.mjs",
    "wcl:probe:survival:v1.1:audit": "node tools/scripts/wcl-probe-survival-v1_1-audit.mjs",
    "realms:sync": "node tools/scripts/with-env.mjs pnpm --filter @mplus/worker run realms:sync --",
    "season:sync-authority": "node tools/scripts/with-env.mjs pnpm --filter @mplus/worker run season:sync-authority --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "abilities:validate": "pnpm --filter @mplus/abilities run abilities:validate",
    "abilities:coverage": "pnpm --filter @mplus/abilities run abilities:coverage",
    "ops:restore-test": "bash infra/scripts/restore-test-local.sh test",
    "ops:generate-secrets": "bash infra/scripts/generate-secrets.sh",
    "ops:validate-dual-env": "bash infra/scripts/validate-dual-env.sh",
    "ops:validate-env": "bash infra/scripts/validate-env.sh",
    "ops:deploy:prod": "bash infra/scripts/deploy.sh prod",
    "ops:deploy:test": "bash infra/scripts/deploy.sh test",
    "ops:smoke": "bash infra/scripts/smoke-deploy.sh",
    "promote:test": "node tools/scripts/promote-test.mjs",
    "iam:grant-admin": "node tools/scripts/with-env.mjs pnpm --filter @mplus/api exec tsx src/iam/grant-admin.cli.ts",
    "test:frontend-secrets": "vitest run tests/security/frontend-secret-bake.test.ts",
    "catalog:build:offensive": "pnpm --filter @mplus/abilities run catalog:build:offensive",
    "catalog:validate:offensive": "pnpm --filter @mplus/abilities run catalog:validate:offensive",
    "catalog:report:offensive-fight": "pnpm --filter @mplus/abilities run catalog:report:offensive-fight",
    "wcl:probe:offensive-one-fight": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-offensive-one-fight.mjs",
    "wcl:probe:utility-one-fight": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-utility-one-fight.mjs",
    "wcl:probe:survival-one-fight": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-survival-one-fight.mjs",
    "wcl:probe:capability-evidence": "node tools/scripts/with-env.mjs node tools/scripts/wcl-probe-capability-evidence.mjs",
    "scoring:canary": "node tools/scripts/with-env.mjs pnpm --filter @mplus/worker run scoring:canary --",
    "scoring:replay": "node tools/scripts/with-env.mjs pnpm --filter @mplus/worker run scoring:replay --",
    "scoring:doctor": "node tools/scripts/with-env.mjs pnpm --filter @mplus/worker run scoring:doctor --",
    "scoring:smoke:character": "node tools/scripts/with-env.mjs pnpm --filter @mplus/worker run scoring:smoke:character --"
  },
  "dependencies": {
    "@mplus/config": "workspace:*",
    "@mplus/observability": "workspace:*",
    "@mplus/worker": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.20.1",
    "autocannon": "^8.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "pg": "^8.22.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
