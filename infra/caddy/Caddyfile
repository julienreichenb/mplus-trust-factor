# Shared Caddy edge — routes both environments. Only this process binds :80/:443.
#
# Env (from /opt/mplus/shared/caddy/.env):
#   ACME_EMAIL
#   APP_PROD_DOMAIN   e.g. trust.example.com
#   APP_TEST_DOMAIN   e.g. test.trust.example.com
#
# Upstream aliases are created by app compose overrides on network mplus-proxy:
#   mplus-prod-api / mplus-prod-web
#   mplus-test-api / mplus-test-web

{
	email {$ACME_EMAIL}
}

(mplus_site) {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@api path /api/* /health/* /docs /docs/*
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy {args[0]}:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Request-ID {header.X-Request-ID}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	handle {
		reverse_proxy {args[1]}:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format console
	}
}

{$APP_PROD_DOMAIN} {
	import mplus_site mplus-prod-api mplus-prod-web
}

{$APP_TEST_DOMAIN} {
	import mplus_site mplus-test-api mplus-test-web
}
