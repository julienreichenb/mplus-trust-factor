# /opt/mplus/prod/.env — PRODUCTION only (chmod 600). Never share with test.
# Generate: ./infra/scripts/generate-secrets.sh prod

NODE_ENV=production
APP_ENV=production
APP_DOMAIN=trust.example.com
LOG_LEVEL=info
TZ=UTC

GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=replace-with-git-sha

POSTGRES_DB=mplus_trust_prod
POSTGRES_USER=mplus_prod
POSTGRES_PASSWORD=CHANGE_ME_PROD_DB
REDIS_PASSWORD=CHANGE_ME_PROD_REDIS
REDIS_MAXMEMORY=256mb

# Compose injects DATABASE_URL/REDIS_URL; keep for tooling if needed:
DATABASE_URL=postgresql://mplus_prod:CHANGE_ME_PROD_DB@postgres:5432/mplus_trust_prod?schema=public
REDIS_URL=redis://:CHANGE_ME_PROD_REDIS@redis:6379

RAW_ARTIFACTS_DIR=/data/raw-artifacts
RAW_ARTIFACT_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=14

ADMIN_API_KEY=CHANGE_ME_PROD_ADMIN
SESSION_SECRET=CHANGE_ME_PROD_SESSION_SECRET_AT_LEAST_32_CHARS

PROVIDER_MODE=live
ALLOW_LIVE_PROVIDER_CALLS=false

BLIZZARD_ENABLED=true
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_DEFAULT_REGION=eu
BLIZZARD_DEFAULT_LOCALE=en_GB

WCL_ENABLED=true
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_MPLUS_ZONE_ID=47

RAIDERIO_ENABLED=true
RAIDERIO_APP_KEY=

ACTIVE_SCORE_MODEL_KEY=default
ACTIVE_SCORE_MODEL_VERSION=4
MANUAL_REFRESH_COOLDOWN_SECONDS=900
# Utility shadow diagnostics only (off|shadow|published). Default shadow. Do not set published.
UTILITY_PUBLICATION_MODE=shadow
PUBLIC_DETAILS_ALL=true
WORKER_HEALTH_PORT=3001
TRUST_PROXY=true
COOKIE_DOMAIN=trust.example.com
WEB_ORIGIN=https://trust.example.com
PUBLIC_BASE_URL=https://trust.example.com
