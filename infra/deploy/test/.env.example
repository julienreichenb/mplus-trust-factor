# /opt/mplus/test/.env — TEST only (chmod 600). Do NOT reuse production secrets.
# Generate secrets: ./infra/scripts/generate-secrets.sh test
# Placeholder domain: test.trust.example.com (replace with real APP_TEST_DOMAIN).

NODE_ENV=production
APP_ENV=staging
APP_DOMAIN=test.trust.example.com
LOG_LEVEL=info
TZ=UTC

# Staging starts as collector until production is the sole crawler.
PROVIDER_DATA_ROLE=collector
PROVIDER_DATA_DIR=/opt/mplus/shared/provider-data

GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=replace-with-git-sha

POSTGRES_DB=mplus_trust_test
POSTGRES_USER=mplus_test
POSTGRES_PASSWORD=CHANGE_ME_TEST_DB
REDIS_PASSWORD=CHANGE_ME_TEST_REDIS
REDIS_MAXMEMORY=128mb

DATABASE_URL=postgresql://mplus_test:CHANGE_ME_TEST_DB@postgres:5432/mplus_trust_test?schema=public
REDIS_URL=redis://:CHANGE_ME_TEST_REDIS@redis:6379

RAW_ARTIFACTS_DIR=/data/raw-artifacts
RAW_ARTIFACT_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=7

# --- Auth / IAM ---
# Emergency shared key: keep false on shared test once first admin is bootstrapped.
ADMIN_API_KEY=CHANGE_ME_TEST_ADMIN
ADMIN_API_KEY_EMERGENCY_FALLBACK=false
# After the operator's Battle.net account exists (OAuth login once), set exactly one:
# ADMIN_BOOTSTRAP_USER_ID=
# ADMIN_BOOTSTRAP_BATTLENET_SUBJECT=
# Startup grant is idempotent and audited. Do not commit real subject values.

# Session cookie HMAC / encryption material (>=32 chars). Also used for OAuth state cookies.
SESSION_SECRET=CHANGE_ME_TEST_SESSION_SECRET_AT_LEAST_32_CHARS
# Optional dedicated key for Battle.net provider tokens at rest (defaults to SESSION_SECRET).
PROVIDER_TOKEN_ENCRYPTION_SECRET=CHANGE_ME_TEST_PROVIDER_TOKEN_SECRET_32CHARS

SESSION_COOKIE_NAME=mplus_session
SESSION_TTL_SECONDS=2592000
OAUTH_STATE_TTL_SECONDS=600
# Secure cookies: APP_ENV=staging|production enables Secure flag automatically.
COOKIE_DOMAIN=test.trust.example.com
TRUST_PROXY=true
WEB_ORIGIN=https://test.trust.example.com
PUBLIC_BASE_URL=https://test.trust.example.com

# Battle.net user OAuth (authorization-code). Use a SEPARATE Blizzard API client from production.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BATTLENET_OAUTH_CALLBACK_URLS=https://test.trust.example.com/api/v1/auth/battlenet/callback
BATTLENET_OAUTH_SCOPES="openid wow.profile"
BATTLENET_OAUTH_AUTHORIZE_URL=https://oauth.battle.net/authorize
BATTLENET_OAUTH_TOKEN_URL=https://oauth.battle.net/token
BATTLENET_OAUTH_USERINFO_URL=https://oauth.battle.net/userinfo
# MVP ownership sync is EU-only.
BATTLENET_OWNERSHIP_SYNC_REGION=eu
OWNER_REFRESH_COOLDOWN_BYPASS=false

PROVIDER_MODE=fixture
ALLOW_LIVE_PROVIDER_CALLS=false

BLIZZARD_ENABLED=true
BLIZZARD_DEFAULT_REGION=eu
BLIZZARD_DEFAULT_LOCALE=en_GB

WCL_ENABLED=true
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

RAIDERIO_ENABLED=true
RAIDERIO_APP_KEY=

# Empty-DB bootstrap / lookup aids only — NOT normal model activation (admin/DB).
# Deploy seeds only when ScoreModel catalog is empty; day-to-day activation is admin UI.
ACTIVE_SCORE_MODEL_KEY=default
ACTIVE_SCORE_MODEL_VERSION=6
MANUAL_REFRESH_COOLDOWN_SECONDS=900
UTILITY_PUBLICATION_MODE=shadow
PUBLIC_DETAILS_ALL=true
WORKER_HEALTH_PORT=3001
