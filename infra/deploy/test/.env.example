# /opt/mplus/test/.env — TEST only (chmod 600). Do NOT reuse production secrets/credentials
# unless ALLOW_SHARED_PROVIDER_CREDENTIALS is explicitly set in ops docs for a throwaway sandbox.
# Generate: ./infra/scripts/generate-secrets.sh test

NODE_ENV=production
APP_ENV=staging
APP_DOMAIN=test.trust.example.com
LOG_LEVEL=info
TZ=UTC

GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=replace-with-git-sha

POSTGRES_DB=mplus_trust_test
POSTGRES_USER=mplus_test
POSTGRES_PASSWORD=CHANGE_ME_TEST_DB
REDIS_PASSWORD=CHANGE_ME_TEST_REDIS
REDIS_MAXMEMORY=128mb

DATABASE_URL=postgresql://mplus_test:CHANGE_ME_TEST_DB@postgres:5432/mplus_trust_test?schema=public
REDIS_URL=redis://:CHANGE_ME_TEST_REDIS@redis:6379

RAW_ARTIFACTS_DIR=/data/raw-artifacts
RAW_ARTIFACT_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=7

ADMIN_API_KEY=CHANGE_ME_TEST_ADMIN
SESSION_SECRET=CHANGE_ME_TEST_SESSION_SECRET_AT_LEAST_32_CHARS

PROVIDER_MODE=fixture
ALLOW_LIVE_PROVIDER_CALLS=false

# Prefer fixture on test. If enabling live, use SEPARATE provider apps/keys — not production.
BLIZZARD_ENABLED=true
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_DEFAULT_REGION=eu
BLIZZARD_DEFAULT_LOCALE=en_GB

WCL_ENABLED=true
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_MPLUS_ZONE_ID=47

RAIDERIO_ENABLED=true
RAIDERIO_APP_KEY=

ACTIVE_SCORE_MODEL_KEY=default
ACTIVE_SCORE_MODEL_VERSION=4
MANUAL_REFRESH_COOLDOWN_SECONDS=900
# Utility shadow diagnostics only (off|shadow|published). Default shadow. Do not set published.
UTILITY_PUBLICATION_MODE=shadow
PUBLIC_DETAILS_ALL=true
WORKER_HEALTH_PORT=3001
TRUST_PROXY=true
COOKIE_DOMAIN=test.trust.example.com
WEB_ORIGIN=https://test.trust.example.com
PUBLIC_BASE_URL=https://test.trust.example.com
