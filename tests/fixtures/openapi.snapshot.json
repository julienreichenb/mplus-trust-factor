{
  "openapi": "3.0.3",
  "info": {
    "title": "M+ Trust Factor API",
    "version": "0.1.0",
    "description": "Foundation OpenAPI surface — domain routes owned by Agent 5"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
