model IngestionJob {
  id          String    @id @default(uuid()) @db.Uuid
  jobType     String    @map("job_type")
  characterId String?   @map("character_id") @db.Uuid
  runId       String?   @map("run_id") @db.Uuid
  status      JobStatus @default(QUEUED)
  dedupeKey   String?   @unique @map("dedupe_key")
  priority    Int       @default(0)
  attempts    Int       @default(0)
  payload     Json      @default("{}")
  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  error       Json?
  /** BullMQ execution job id (unique per publish). Used for cancel / prioritize. */
  queueJobId         String?   @map("queue_job_id")
  /** Cooperative cancellation request for ACTIVE refresh jobs. */
  cancelRequestedAt  DateTime? @map("cancel_requested_at") @db.Timestamptz(3)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?   @map("cancel_reason")
  /**
   * Explicit refresh workload lane. Default OPERATION for backward compatibility.
   * Calibration cohort bootstrap / evidence acquisition must set CALIBRATION.
   */
  workloadClass      RefreshWorkloadClass @default(OPERATION) @map("workload_class")

  character Character? @relation(fields: [characterId], references: [id])
  run       MythicRun? @relation(fields: [runId], references: [id])
  refreshAdmission RefreshAdmission?

  @@index([status, scheduledAt])
  @@index([jobType, status, scheduledAt])
  /** Bounded ETA throughput reads: recent COMPLETED rows by completedAt. */
  @@index([jobType, status, completedAt])
  @@index([cancelRequestedAt])
  @@index([workloadClass, status, scheduledAt])
  @@map("ingestion_jobs")
}

