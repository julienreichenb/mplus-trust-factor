  invalidReasons    Json      @default("[]") @map("invalid_reasons")
  providerDataAsOf  DateTime? @map("provider_data_as_of") @db.Timestamptz(3)

  manifest  EvidenceManifest  @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  dungeon   Dungeon           @relation(fields: [dungeonId], references: [id])
  run       MythicRun?        @relation(fields: [runId], references: [id])
  datasets  EvidenceDataset[]
  factSets  RunFactSet[]

  @@unique([manifestId, dungeonId, slotIndex])
  @@index([manifestId, state])
  @@index([reportCode, fightId])
