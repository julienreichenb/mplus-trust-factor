  expectedSlotCount   Int           @map("expected_slot_count")
  selectedSlotCount   Int           @map("selected_slot_count")
  coverageState       String        @map("coverage_state")
  schemaVersion       String        @map("schema_version")
  /** SHA-256 of canonical frozen document (immutable identity). */
  contentHash         String        @unique @map("content_hash")
  /** Bounded EvidenceManifestV2 JSON document — no raw event arrays. */
  document            Json
  frozenAt            DateTime      @map("frozen_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

