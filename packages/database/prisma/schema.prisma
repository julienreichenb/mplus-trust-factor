  specialization        GameSpecialization?    @relation(fields: [specializationId], references: [id])
  slots                 EvidenceManifestSlot[]
  dimensionComputations DimensionComputation[]
  scoreSnapshots        ScoreSnapshot[]
  analysisBatches       ScoreAnalysisBatch[]

  @@index([characterId, seasonId, frozenAt(sort: Desc)])
  @@index([frozenAt(sort: Desc)])
  @@map("evidence_manifests")
}

model EvidenceManifestSlot {
  id                String    @id @default(uuid()) @db.Uuid
  manifestId        String    @map("manifest_id") @db.Uuid
  dungeonId         String    @map("dungeon_id") @db.Uuid
  slotIndex         Int       @map("slot_index")
  runId             String?   @map("run_id") @db.Uuid
  reportCode        String?   @map("report_code")
  fightId           Int?      @map("fight_id")
  reportRevision    Int?      @map("report_revision")
  keyLevel          Int?      @map("key_level")
  candidateRank     Int?      @map("candidate_rank")
  state             String
  selectionReason   String?   @map("selection_reason")
