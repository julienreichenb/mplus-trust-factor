generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  BLIZZARD
  WARCRAFT_LOGS
  RAIDER_IO
}

enum CharacterRole {
  DPS
  TANK
  HEALER
}

enum AccountLinkConfidence {
  CONFIRMED
  PROBABLE
}

enum ArtifactCompression {
  NONE
  GZIP
  ZSTD
}

enum ScoreDimension {
  PERFORMANCE
  SURVIVAL
  UTILITY
  EXPERIENCE
  RAID
  AUTHENTICITY
}

enum MetricDirection {
  HIGHER_BETTER
  LOWER_BETTER
  CONTEXTUAL
}

enum ScopeType {
  CHARACTER
  ROLE
  CLASS
  SPEC
  ACCOUNT
}

enum MechanicRuleType {
  AVOIDABLE_DAMAGE
  MANDATORY_DAMAGE
  PRIORITY_INTERRUPT
  CROWD_CONTROL
  DISPEL
  PURGE
  DEFENSIVE_WINDOW
  EXTERNAL_WINDOW
}

enum ScoreModelStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RedFlagSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RedFlagStatus {
  ACTIVE
  CLEARED
  DISPUTED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

enum OwnershipStatus {
  CURRENT
  HISTORICAL
  STALE
  REVOKED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum AddonExportStatus {
  PENDING
  READY
  FAILED
}

enum ScorePublicationStatus {
  DRAFT
  CANDIDATE
  PUBLIC
  PUBLISHED
  SUPERSEDED
  REJECTED_INCOMPLETE
}

enum AnalysisRunJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  UNAVAILABLE
  FAILED
}

enum ScoreFinalizationStatus {
  PENDING
  READY_TO_FINALIZE
  FINALIZING
  FINALIZED
  FAILED
  EXPIRED
}

enum ProviderLifecycleState {
  OK
  STALE
  UNAVAILABLE
  RATE_LIMITED
  PRIVATE_OR_HIDDEN
  NOT_FOUND
}

model Region {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  apiHost       String   @map("api_host")
  localeDefault String   @map("locale_default")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  realms             Realm[]
  seasons            Season[]
  characters         Character[]
  characterAliases   CharacterAlias[]
  mythicRuns         MythicRun[]
  battleNetAccounts  BattleNetAccount[]
  addonExports       AddonExport[]
  verifiedOwnerships VerifiedCharacterOwnership[]

  @@map("regions")
}

model Realm {
  id               String    @id @default(uuid()) @db.Uuid
  regionId         String    @map("region_id") @db.Uuid
  blizzardRealmId  BigInt?   @map("blizzard_realm_id")
  slug             String
  name             String
  /** Accent-folded lowercase name for catalog search (display `name` preserves accents). */
  nameNormalized   String?   @map("name_normalized")
  connectedRealmId BigInt?   @map("connected_realm_id")
  locale           String?
  timezone         String?
  category         String?
  isTournament     Boolean   @default(false) @map("is_tournament")
  /** False when omitted from successive Blizzard syncs; never hard-deleted on a single miss. */
  isActive         Boolean   @default(true) @map("is_active")
  lastSyncedAt     DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  region     Region      @relation(fields: [regionId], references: [id])
  characters Character[]

  @@unique([regionId, slug])
  @@index([nameNormalized])
  @@index([isActive, isTournament])
  @@map("realms")
}

model Season {
  id                String    @id @default(uuid()) @db.Uuid
  regionId          String?   @map("region_id") @db.Uuid
  blizzardSeasonId  Int?      @map("blizzard_season_id")
  providerSeasonId  String?   @map("provider_season_id")
  slug              String
  name              String
  startsAt          DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime? @map("ends_at") @db.Timestamptz(3)
  isCurrent         Boolean   @default(false) @map("is_current")
  dungeonCount      Int       @default(0) @map("dungeon_count")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  region           Region?           @relation(fields: [regionId], references: [id])
  seasonDungeons   SeasonDungeon[]
  mythicRuns       MythicRun[]
  metricObservations MetricObservation[]
  mechanicRules    MechanicRule[]
  scoreSnapshots   ScoreSnapshot[]
  characterRedFlags CharacterRedFlag[]
  addonExports     AddonExport[]
  analysisBatches  ScoreAnalysisBatch[]
  publishedScores  CharacterPublishedScore[]

  @@unique([regionId, slug])
  @@map("seasons")
}

model Dungeon {
  id                 String   @id @default(uuid()) @db.Uuid
  blizzardDungeonId  BigInt?  @map("blizzard_dungeon_id")
  wclZoneOrEncounterId BigInt? @map("wcl_zone_or_encounter_id")
  raiderioSlug       String?  @map("raiderio_slug")
  slug               String   @unique
  name               String
  mapId              Int?     @map("map_id")
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seasonDungeons SeasonDungeon[]
  mythicRuns     MythicRun[]
  mechanicRules  MechanicRule[]

  @@map("dungeons")
}

model SeasonDungeon {
  seasonId        String  @map("season_id") @db.Uuid
  dungeonId       String  @map("dungeon_id") @db.Uuid
  sortOrder       Int     @default(0) @map("sort_order")
  timerSeconds    Int?    @map("timer_seconds")
  baselineKeyLevel Int    @default(10) @map("baseline_key_level")
  metadata        Json    @default("{}")

  season  Season  @relation(fields: [seasonId], references: [id])
  dungeon Dungeon @relation(fields: [dungeonId], references: [id])

  @@id([seasonId, dungeonId])
  @@map("season_dungeons")
}

model GameClass {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  providerIds Json     @default("{}") @map("provider_ids")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  specializations GameSpecialization[]
  characters      Character[]
  runParticipants RunParticipant[]

  @@map("game_classes")
}

model GameSpecialization {
  id          String        @id @default(uuid()) @db.Uuid
  classId     String        @map("class_id") @db.Uuid
  slug        String
  name        String
  role        CharacterRole
  providerIds Json          @default("{}") @map("provider_ids")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  gameClass           GameClass            @relation(fields: [classId], references: [id])
  charactersAsActive  Character[]          @relation("ActiveSpec")
  characterSnapshots  CharacterSnapshot[]
  talentSnapshots     TalentSnapshot[]
  runParticipants     RunParticipant[]

  @@unique([classId, slug])
  @@map("game_specializations")
}

model Character {
  id                   String         @id @default(uuid()) @db.Uuid
  regionId             String         @map("region_id") @db.Uuid
  realmId              String         @map("realm_id") @db.Uuid
  normalizedName       String         @map("normalized_name")
  displayName          String         @map("display_name")
  level                Int?
  faction              String?
  classId              String?        @map("class_id") @db.Uuid
  activeSpecId         String?        @map("active_spec_id") @db.Uuid
  role                 CharacterRole?
  blizzardCharacterId  BigInt?        @map("blizzard_character_id")
  wclCanonicalId       BigInt?        @map("wcl_canonical_id")
  raiderioProfileUrl   String?        @map("raiderio_profile_url")
  profileUrl           String?        @map("profile_url")
  lastSeenAt           DateTime?      @map("last_seen_at") @db.Timestamptz(3)
  lastPublicRefreshAt  DateTime?      @map("last_public_refresh_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  region            Region              @relation(fields: [regionId], references: [id])
  realm             Realm               @relation(fields: [realmId], references: [id])
  gameClass         GameClass?          @relation(fields: [classId], references: [id])
  activeSpec        GameSpecialization? @relation("ActiveSpec", fields: [activeSpecId], references: [id])
  aliases           CharacterAlias[]
  snapshots         CharacterSnapshot[]
  verifiedOwnerships VerifiedCharacterOwnership[]
  runParticipants   RunParticipant[]
  runAnalyses       RunAnalysis[]
  metricObservations MetricObservation[]
  scoreSnapshots    ScoreSnapshot[]
  redFlags          CharacterRedFlag[]
  disputes          ScoreDispute[]
  ingestionJobs     IngestionJob[]
  providerStates    CharacterProviderState[]
  analysisBatches   ScoreAnalysisBatch[]
  publishedScores   CharacterPublishedScore[]
  profileViews      CharacterProfileView[]
  refreshScheduleItems RefreshScheduleItem[]
  refreshCostEntries RefreshCostLedgerEntry[]
  bulkOperationItems BulkOperationItem[]

  @@unique([regionId, realmId, normalizedName])
  @@index([lastPublicRefreshAt])
  @@map("characters")
}

model CharacterProviderState {
  id                    String                 @id @default(uuid()) @db.Uuid
  characterId           String                 @map("character_id") @db.Uuid
  provider              Provider
  state                 ProviderLifecycleState
  detail                String?
  warnings              Json                   @default("[]")
  disagreements         Json                   @default("[]")
  excludedObservations  Json                   @default("[]") @map("excluded_observations")
  wclVisibility         String?                @map("wcl_visibility")
  lastAttemptAt         DateTime               @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt         DateTime?              @map("last_success_at") @db.Timestamptz(3)
  fetchedAt             DateTime?              @map("fetched_at") @db.Timestamptz(3)
  expiresAt             DateTime?              @map("expires_at") @db.Timestamptz(3)
  metadata              Json                   @default("{}")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, provider])
  @@index([provider, state])
  @@map("character_provider_states")
}

model CharacterAlias {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  regionId       String    @map("region_id") @db.Uuid
  realmSlug      String    @map("realm_slug")
  normalizedName String    @map("normalized_name")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo        DateTime? @map("valid_to") @db.Timestamptz(3)
  sourceProvider Provider  @map("source_provider")

  character Character @relation(fields: [characterId], references: [id])
  region    Region    @relation(fields: [regionId], references: [id])

  @@unique([regionId, realmSlug, normalizedName])
  @@map("character_aliases")
}

model BattleNetAccount {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  /** Durable Battle.net account id / OAuth subject — never treat BattleTag as durable. */
  providerAccountId      String    @unique @map("provider_account_id")
  regionId               String?   @map("region_id") @db.Uuid
  battletagHash          String    @map("battletag_hash")
  battletagDisplay       String?   @map("battletag_display")
  claimed                Boolean   @default(true)
  linkedAt               DateTime  @default(now()) @map("linked_at") @db.Timestamptz(3)
  unlinkedAt             DateTime? @map("unlinked_at") @db.Timestamptz(3)
  accessTokenEncrypted   String?   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted  String?   @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt         DateTime? @map("token_expires_at") @db.Timestamptz(3)
  grantedScopes          String?   @map("granted_scopes")
  lastOwnershipSyncAt    DateTime? @map("last_ownership_sync_at") @db.Timestamptz(3)
  lastOwnershipSyncError String?   @map("last_ownership_sync_error")
  /** Last discover-owned-characters IngestionJob id (logical). */
  lastDiscoveryJobId       String?   @map("last_discovery_job_id") @db.Uuid
  lastDiscoveryStatus      String?   @map("last_discovery_status")
  lastDiscoveryStartedAt   DateTime? @map("last_discovery_started_at") @db.Timestamptz(3)
  lastDiscoveryFinishedAt  DateTime? @map("last_discovery_finished_at") @db.Timestamptz(3)
  lastDiscoveryError       String?   @map("last_discovery_error")
  lastDiscoveryCounters    Json?     @map("last_discovery_counters")
  /** Ownership sync revision the latest discovery was keyed against. */
  lastDiscoveryOwnershipSyncAt DateTime? @map("last_discovery_ownership_sync_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  region     Region?                      @relation(fields: [regionId], references: [id])
  ownerships VerifiedCharacterOwnership[]

  @@index([userId])
  @@index([battletagHash])
  @@map("battlenet_accounts")
}

/** Provider-backed ownership. Private by default — never exposed on public profile APIs. */
model VerifiedCharacterOwnership {
  id                   String                 @id @default(uuid()) @db.Uuid
  battleNetAccountId   String                 @map("battlenet_account_id") @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  characterId          String?                @map("character_id") @db.Uuid
  blizzardCharacterId  BigInt                 @map("blizzard_character_id")
  regionId             String                 @map("region_id") @db.Uuid
  realmSlug            String                 @map("realm_slug")
  realmName            String?                @map("realm_name")
  characterName        String                 @map("character_name")
  normalizedName       String                 @map("normalized_name")
  playableClassId      Int?                   @map("playable_class_id")
  playableRaceId       Int?                   @map("playable_race_id")
  characterLevel       Int?                   @map("character_level")
  faction              String?
  confidence           AccountLinkConfidence  @default(CONFIRMED)
  source               String
  status               OwnershipStatus        @default(CURRENT)
  isPrimary            Boolean                @default(false) @map("is_primary")
  verifiedAt           DateTime               @map("verified_at") @db.Timestamptz(3)
  lastSeenAt           DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt            DateTime?              @map("revoked_at") @db.Timestamptz(3)
  /** Owned-character relevance policy diagnostics (private). */
  relevancePolicyVersion String?              @map("relevance_policy_version")
  relevanceEligible      Boolean?             @map("relevance_eligible")
  relevanceReasons       Json?                @map("relevance_reasons")
  relevanceEvaluatedAt   DateTime?            @map("relevance_evaluated_at") @db.Timestamptz(3)
  currentSeasonMythicRating   Float?          @map("current_season_mythic_rating")
  currentSeasonMythicSeasonId String?         @map("current_season_mythic_season_id")
  currentSeasonMythicFetchedAt DateTime?      @map("current_season_mythic_fetched_at") @db.Timestamptz(3)
  currentSeasonMythicSource   String?         @map("current_season_mythic_source")
  currentSeasonMythicState    String?         @map("current_season_mythic_state")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  battleNetAccount BattleNetAccount @relation(fields: [battleNetAccountId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  character        Character?       @relation(fields: [characterId], references: [id])
  region           Region           @relation(fields: [regionId], references: [id])

  @@unique([battleNetAccountId, blizzardCharacterId])
  @@index([userId, status])
  @@index([characterId])
  @@index([regionId, realmSlug, normalizedName])
  @@map("verified_character_ownerships")
}

model CharacterSnapshot {
  id                String         @id @default(uuid()) @db.Uuid
  characterId       String         @map("character_id") @db.Uuid
  capturedAt        DateTime       @map("captured_at") @db.Timestamptz(3)
  itemLevelEquipped Float?         @map("item_level_equipped")
  activeSpecId      String?        @map("active_spec_id") @db.Uuid
  role              CharacterRole?
  mythicRating      Float?         @map("mythic_rating")
  sourcePayloadId   String?        @map("source_payload_id") @db.Uuid
  rawSummary        Json           @default("{}") @map("raw_summary")

  character   Character            @relation(fields: [characterId], references: [id])
  activeSpec  GameSpecialization?  @relation(fields: [activeSpecId], references: [id])
  equipment   EquipmentSnapshot?
  talents     TalentSnapshot[]

  @@index([characterId, capturedAt(sort: Desc)])
  @@map("character_snapshots")
}

model EquipmentSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  characterSnapshotId  String   @unique @map("character_snapshot_id") @db.Uuid
  capturedAt           DateTime @map("captured_at") @db.Timestamptz(3)
  averageItemLevel     Float?   @map("average_item_level")
  equippedItemLevel    Float?   @map("equipped_item_level")
  items                Json     @default("[]")
  keyItems             Json     @default("{}") @map("key_items")
  sourcePayloadId      String?  @map("source_payload_id") @db.Uuid

  characterSnapshot CharacterSnapshot @relation(fields: [characterSnapshotId], references: [id])

  @@map("equipment_snapshots")
}

model TalentSnapshot {
  id                  String   @id @default(uuid()) @db.Uuid
  characterSnapshotId String   @map("character_snapshot_id") @db.Uuid
  specializationId    String?  @map("specialization_id") @db.Uuid
  loadoutCode         String?  @map("loadout_code")
  talents             Json     @default("{}")
  sourcePayloadId     String?  @map("source_payload_id") @db.Uuid

  characterSnapshot CharacterSnapshot    @relation(fields: [characterSnapshotId], references: [id])
  specialization    GameSpecialization?  @relation(fields: [specializationId], references: [id])

  @@map("talent_snapshots")
}

model ExternalRequest {
  id                 String    @id @default(uuid()) @db.Uuid
  provider           Provider
  requestFingerprint String    @unique @map("request_fingerprint")
  endpointKey        String    @map("endpoint_key")
  method             String
  requestedAt        DateTime  @map("requested_at") @db.Timestamptz(3)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  statusCode         Int?      @map("status_code")
  cacheHit           Boolean   @default(false) @map("cache_hit")
  retryCount         Int       @default(0) @map("retry_count")
  costUnits          Float?    @map("cost_units")
  errorCode          String?   @map("error_code")
  responseHeaders    Json?     @map("response_headers")
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(3)
  etag               String?
  lastModified       String?   @map("last_modified")

  payloads ExternalPayload[]

  @@index([provider, endpointKey, requestedAt(sort: Desc)])
  @@map("external_requests")
}

model ExternalPayload {
  id                String   @id @default(uuid()) @db.Uuid
  externalRequestId String   @map("external_request_id") @db.Uuid
  provider          Provider
  contentHash       String   @map("content_hash")
  payload           Json?
  artifactId        String?  @map("artifact_id") @db.Uuid
  fetchedAt         DateTime @map("fetched_at") @db.Timestamptz(3)
  schemaVersion     String   @map("schema_version")

  externalRequest ExternalRequest @relation(fields: [externalRequestId], references: [id])
  artifact        RawArtifact?    @relation(fields: [artifactId], references: [id])

  @@unique([provider, contentHash])
  @@map("external_payloads")
}

model RawArtifact {
  id             String              @id @default(uuid()) @db.Uuid
  provider       Provider
  storageUri     String              @map("storage_uri")
  compression    ArtifactCompression @default(NONE)
  contentHash    String              @map("content_hash")
  sizeBytes      BigInt              @map("size_bytes")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  retentionUntil DateTime?           @map("retention_until") @db.Timestamptz(3)

  payloads     ExternalPayload[]
  addonExports AddonExport[]

  @@index([contentHash])
  @@map("raw_artifacts")
}

model MythicRun {
  id                   String   @id @default(uuid()) @db.Uuid
  seasonId             String   @map("season_id") @db.Uuid
  dungeonId            String   @map("dungeon_id") @db.Uuid
  regionId             String   @map("region_id") @db.Uuid
  keyLevel             Int      @map("key_level")
  completedAt          DateTime @map("completed_at") @db.Timestamptz(3)
  durationMs           Int      @map("duration_ms")
  timerMs              Int?     @map("timer_ms")
  timed                Boolean
  scoreValue           Float?   @map("score_value")
  canonicalFingerprint String   @unique @map("canonical_fingerprint")
  affixes              Json     @default("[]")
  sourceQuality        Int      @default(0) @map("source_quality") @db.SmallInt
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  season       Season               @relation(fields: [seasonId], references: [id])
  dungeon      Dungeon              @relation(fields: [dungeonId], references: [id])
  region       Region               @relation(fields: [regionId], references: [id])
  sources      RunSourceReference[]
  participants RunParticipant[]
  analyses     RunAnalysis[]
  metricObservations MetricObservation[]
  redFlags     CharacterRedFlag[]
  ingestionJobs IngestionJob[]
  analysisBatchRuns ScoreAnalysisBatchRun[]

  @@index([seasonId, dungeonId, keyLevel, completedAt])
  @@index([completedAt(sort: Desc)])
  @@map("mythic_runs")
}

model RunSourceReference {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  provider        Provider
  externalRunId   String   @map("external_run_id")
  externalUrl     String?  @map("external_url")
  sourcePayloadId String?  @map("source_payload_id") @db.Uuid
  reportCode      String?  @map("report_code")
  fightId         Int?     @map("fight_id")
  revision        Int?

  run MythicRun @relation(fields: [runId], references: [id])

  @@unique([provider, externalRunId])
  @@unique([provider, reportCode, fightId])
  @@map("run_source_references")
}

model RunParticipant {
  id                  String         @id @default(uuid()) @db.Uuid
  runId               String         @map("run_id") @db.Uuid
  characterId         String?        @map("character_id") @db.Uuid
  providerCharacterKey String        @map("provider_character_key")
  displayName         String         @map("display_name")
  realmSlug           String         @map("realm_slug")
  regionCode          String         @map("region_code")
  classId             String?        @map("class_id") @db.Uuid
  specId              String?        @map("spec_id") @db.Uuid
  role                CharacterRole?
  itemLevel           Float?         @map("item_level")
  mythicRatingAtRun   Float?         @map("mythic_rating_at_run")
  isTargetCharacter   Boolean        @default(false) @map("is_target_character")
  sourcePayloadId     String?        @map("source_payload_id") @db.Uuid

  run       MythicRun            @relation(fields: [runId], references: [id])
  character Character?           @relation(fields: [characterId], references: [id])
  gameClass GameClass?           @relation(fields: [classId], references: [id])
