  visibility           String
  archiveState         String?  @map("archive_state")
  startTimeMs          BigInt   @map("start_time_ms")
  endTimeMs            BigInt   @map("end_time_ms")
  zoneId               Int?     @map("zone_id")
  masterDataArtifactId String?  @map("master_data_artifact_id") @db.Uuid
  metadataHash         String   @map("metadata_hash")
  fetchedAt            DateTime @map("fetched_at") @db.Timestamptz(3)

  masterDataArtifact RawArtifact? @relation(fields: [masterDataArtifactId], references: [id])

  @@unique([reportCode, revision])
  @@index([reportCode])
  @@map("wcl_report_revisions")
}

model EvidenceDataset {
  id                      String    @id @default(uuid()) @db.Uuid
  manifestSlotId          String    @map("manifest_slot_id") @db.Uuid
  datasetKey              String    @map("dataset_key")
  /**
   * Logical compatibility identity (report/fight/revision/kind/contract).
   * Shared across refreshes/manifests that bind the same immutable source evidence.
   * Not globally unique — each frozen slot keeps its own auditable descriptor row.
   * Slot uniqueness is @@unique([manifestSlotId, datasetKey]).
   */
  compatibilityKey        String    @map("compatibility_key")
  artifactId              String?   @map("artifact_id") @db.Uuid
  schemaVersion           String    @map("schema_version")
  providerContractVersion String    @map("provider_contract_version")
  state                   String
  eventCount              Int       @default(0) @map("event_count")
  pageCount               Int       @default(0) @map("page_count")
  truncated               Boolean   @default(false)
  pointsConsumed          Float?    @map("points_consumed")
  costSource              String?   @map("cost_source")
  payloadFingerprint      String?   @map("payload_fingerprint")
  fetchedAt               DateTime? @map("fetched_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /** Optional link to the permanent scoring-neutral run digest for cross-character reuse. */
  digestId                String?   @map("digest_id") @db.Uuid

  manifestSlot EvidenceManifestSlot @relation(fields: [manifestSlotId], references: [id], onDelete: Restrict)
  artifact     RawArtifact?         @relation(fields: [artifactId], references: [id])
  pages        EvidenceDatasetPage[]
  digest       WclRunSourceDigest?  @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@unique([manifestSlotId, datasetKey])
  @@index([compatibilityKey])
  @@index([artifactId])
  @@index([digestId])
  @@map("evidence_datasets")
}

model RunFactSet {
  id               String   @id @default(uuid()) @db.Uuid
  manifestSlotId   String   @map("manifest_slot_id") @db.Uuid
  characterId      String   @map("character_id") @db.Uuid
  runId            String?  @map("run_id") @db.Uuid
  extractorFamily  String   @map("extractor_family")
  extractorVersion String   @map("extractor_version")
  schemaVersion    String   @map("schema_version")
  inputFingerprint String   @map("input_fingerprint")
  /** Bounded normalized facts — never raw WCL event pages. */
  facts            Json
  coverage         Json     @default("{}")
  limitations      Json     @default("[]")
  computedAt       DateTime @map("computed_at") @db.Timestamptz(3)

  manifestSlot EvidenceManifestSlot @relation(fields: [manifestSlotId], references: [id], onDelete: Restrict)
  character    Character            @relation(fields: [characterId], references: [id])
  run          MythicRun?           @relation(fields: [runId], references: [id])

  @@unique([manifestSlotId, extractorFamily, extractorVersion, inputFingerprint])
  @@index([characterId, computedAt(sort: Desc)])
  @@map("run_fact_sets")
}

model DimensionComputation {
  id               String         @id @default(uuid()) @db.Uuid
  characterId      String         @map("character_id") @db.Uuid
  seasonId         String         @map("season_id") @db.Uuid
  manifestId       String         @map("manifest_id") @db.Uuid
  scoreModelId     String         @map("score_model_id") @db.Uuid
  dimension        ScoreDimension
  algorithmVersion String         @map("algorithm_version")
  inputFingerprint String         @map("input_fingerprint")
  score            Decimal?       @db.Decimal(8, 4)
  confidence       Decimal        @db.Decimal(5, 4)
  state            String
  metrics          Json           @default("{}")
  explanation      Json           @default("{}")
  computedAt       DateTime       @map("computed_at") @db.Timestamptz(3)

  character  Character        @relation(fields: [characterId], references: [id])
  season     Season           @relation(fields: [seasonId], references: [id])
  manifest   EvidenceManifest @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  scoreModel ScoreModel       @relation(fields: [scoreModelId], references: [id])

  // Logical identity — one row per dimension for a frozen manifest/model.
  // inputFingerprint is content integrity, not part of the unique identity.
  @@unique([characterId, seasonId, manifestId, scoreModelId, dimension])
  @@index([characterId, seasonId, scoreModelId, computedAt(sort: Desc)])
  @@index([manifestId, dimension])
  @@index([inputFingerprint])
  @@map("dimension_computations")
}

// ---------------------------------------------------------------------------
// Scoring V2 Control Center — typed runtime settings + evidence exports
// ---------------------------------------------------------------------------

/**
 * Typed runtime settings (Zod-validated per key). Not a generic untyped dump.
 * Keys: concurrency_calibration, concurrency_operation.
 */
model RuntimeSetting {
  key             String   @id
  value           Json
  /** Optimistic concurrency token — increment on every successful update. */
  version         Int      @default(1)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("RuntimeSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("runtime_settings")
}

/**
 * Admin evidence-join export job. Provider-free; writes only its own row + artifacts.
 * Never mutates character / evidence / score rows.
 */
model ScoringV2EvidenceExport {
  id                       String                        @id @default(uuid()) @db.Uuid
  cohortId                 String                        @map("cohort_id") @db.Uuid
  /** Immutable cohort revision captured at request time. */
  cohortRevision           Int                           @map("cohort_revision")
  seasonId                 String?                       @map("season_id") @db.Uuid
  scoreModelId             String?                       @map("score_model_id") @db.Uuid
  status                   ScoringV2EvidenceExportStatus @default(QUEUED)
  /** Bounded progress counters (members scanned, etc.). */
  progress                 Json                          @default("{}")
  /** Bounded summary (counts, blockers, warnings) — no artifact bodies. */
  summary                  Json                          @default("{}")
  blockerCount             Int                           @default(0) @map("blocker_count")
  warningCount             Int                           @default(0) @map("warning_count")
  /** Content hash of downloadable archive (summary + preflight + md). */
  archiveContentHash       String?                       @map("archive_content_hash")
  archiveByteLength        Int?                          @map("archive_byte_length")
  archiveStorageUri        String?                       @map("archive_storage_uri")
  summaryContentHash       String?                       @map("summary_content_hash")
  preflightContentHash     String?                       @map("preflight_content_hash")
  markdownContentHash      String?                       @map("markdown_content_hash")
  /** Logical Calibration Input Bundle V2 root hash (stableStringify / bundleHash). */
  frozenBundleContentHash  String?                       @map("frozen_bundle_content_hash")
  /**
   * CAS digest of persisted bundle JSON bytes (`sha256:<64hex>`).
   * Distinct from frozenBundleContentHash (logical identity).
   */
  frozenBundleByteDigest   String?                       @map("frozen_bundle_byte_digest")
  frozenBundleByteLength   Int?                          @map("frozen_bundle_byte_length")
  frozenBundleStorageUri   String?                       @map("frozen_bundle_storage_uri")
  frozenAt                 DateTime?                     @map("frozen_at") @db.Timestamptz(3)
  /**
   * Pinned wall-clock for deterministic join identity (create or first claim).
   * Retries must reuse this; never stamp a fresh now into archive identity.
   */
  generatedAt              DateTime?                     @map("generated_at") @db.Timestamptz(3)
  /** Evidence freshness cutoff pinned with the export request. */
  evidenceCutoffAt         DateTime?                     @map("evidence_cutoff_at") @db.Timestamptz(3)
  /** Claim / recovery attempt counter (M3). */
  attempt                  Int                           @default(0)
  leaseOwner               String?                       @map("lease_owner")
  leaseExpiresAt           DateTime?                     @map("lease_expires_at") @db.Timestamptz(3)
  heartbeatAt              DateTime?                     @map("heartbeat_at") @db.Timestamptz(3)
  /** Hash of the terminal archive set (equals archiveContentHash on success). */
  artifactSetHash          String?                       @map("artifact_set_hash")
  /** Immutable freeze inputs captured at export COMPLETED (H3). */
  freezeSnapshot           Json?                         @map("freeze_snapshot")
  errorCode                String?                       @map("error_code")
  errorMessage             String?                       @map("error_message")
  requestedByUserId        String                        @map("requested_by_user_id") @db.Uuid
  bullmqJobId              String?                       @map("bullmq_job_id")
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt                DateTime?                     @map("started_at") @db.Timestamptz(3)
  completedAt              DateTime?                     @map("completed_at") @db.Timestamptz(3)

  cohort      CalibrationCohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  season      Season?           @relation(fields: [seasonId], references: [id])
  scoreModel  ScoreModel?       @relation(fields: [scoreModelId], references: [id])
  requestedBy User              @relation(fields: [requestedByUserId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([cohortId, createdAt(sort: Desc)])
  @@index([requestedByUserId, createdAt(sort: Desc)])
  @@index([archiveContentHash])
  @@index([frozenBundleContentHash])
  @@index([status, leaseExpiresAt])
  @@map("scoring_v2_evidence_exports")
}

// ---------------------------------------------------------------------------
// Scoring V2 Shadow Canary — durable WCL source reuse + admin canary runs
// ---------------------------------------------------------------------------

/**
 * Immutable WCL event/page bytes stored via RawArtifact (default 30-day retention).
 * One row per page; report revision changes create new page rows (never overwrite).
 */
model EvidenceDatasetPage {
  id                      String   @id @default(uuid()) @db.Uuid
  datasetId               String?  @map("dataset_id") @db.Uuid
  reportCode              String   @map("report_code")
  fightId                 Int      @map("fight_id")
  reportRevision          Int      @map("report_revision")
  datasetKey              String   @map("dataset_key")
  pageIndex               Int      @map("page_index")
  pageCursor              String?  @map("page_cursor")
  artifactId              String   @map("artifact_id") @db.Uuid
  contentHash             String   @map("content_hash")
  providerContractVersion String   @map("provider_contract_version")
  schemaVersion           String   @map("schema_version")
  /**
   * Deterministic request-scope identity (actor/filter/hostility/resources/bounds).
   * Actor-scoped pages must never collide across characters in the same fight.
   */
  scopeFingerprint        String   @default("scope:unscoped") @map("scope_fingerprint")
  eventCount              Int      @default(0) @map("event_count")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dataset  EvidenceDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  artifact RawArtifact      @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@unique([reportCode, fightId, reportRevision, datasetKey, pageIndex, providerContractVersion, schemaVersion, scopeFingerprint], map: "evidence_dataset_pages_scope_unique")
  @@index([datasetId, pageIndex])
  @@index([artifactId])
  @@index([reportCode, fightId, reportRevision])
  @@index([reportCode, fightId, reportRevision, datasetKey, scopeFingerprint], map: "evidence_dataset_pages_scope_lookup_idx")
  @@map("evidence_dataset_pages")
}

/**
 * Permanent scoring-neutral digest for one WCL dungeon run identity.
 * Logical identity: reportCode + fightId + reportRevision.
 * Must never contain scores, grades, weights, penalties, or calculator outputs.
 */
model WclRunSourceDigest {
  id                      String   @id @default(uuid()) @db.Uuid
  reportCode              String   @map("report_code")
  fightId                 Int      @map("fight_id")
  reportRevision          Int      @map("report_revision")
  schemaVersion           String   @map("schema_version")
  providerContractVersion String   @map("provider_contract_version")
  contentFingerprint      String   @map("content_fingerprint")
  /** Bounded neutral digest document — no raw event arrays. */
  digest                  Json
  rawBytesStored          BigInt?  @map("raw_bytes_stored")
  digestBytes             Int?     @map("digest_bytes")
  completenessState       String   @map("completeness_state")
  visibilityState         String   @map("visibility_state")
  region                  String?
  dungeonSlug             String?  @map("dungeon_slug")
  keyLevel                Int?     @map("key_level")
  timed                   Boolean?
  masterDataArtifactId    String?  @map("master_data_artifact_id") @db.Uuid
  acquiredAt              DateTime @map("acquired_at") @db.Timestamptz(3)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  masterDataArtifact RawArtifact?         @relation(fields: [masterDataArtifactId], references: [id])
  participants       WclRunParticipant[]
  datasets           EvidenceDataset[]

  @@unique([reportCode, fightId, reportRevision])
  @@index([contentFingerprint])
  @@index([dungeonSlug, keyLevel])
  @@index([acquiredAt(sort: Desc)])
  @@map("wcl_run_source_digests")
}

/**
 * Five-person dungeon roster for a WclRunSourceDigest.
 * Provider identity fields are immutable; local mappings are additive/nullable.
 */
model WclRunParticipant {
  id                   String   @id @default(uuid()) @db.Uuid
  digestId             String   @map("digest_id") @db.Uuid
  wclActorId           Int      @map("wcl_actor_id")
  wclCanonicalId       String?  @map("wcl_canonical_id")
  characterName        String   @map("character_name")
  realmSlug            String   @map("realm_slug")
  regionCode           String   @map("region_code")
  classSlug            String?  @map("class_slug")
  specSlug             String?  @map("spec_slug")
  role                 String?
  characterId          String?  @map("character_id") @db.Uuid
  blizzardCharacterId  String?  @map("blizzard_character_id")
  mappingState         String   @default("UNRESOLVED") @map("mapping_state")
  mappingConfidence    Float?   @map("mapping_confidence")
  ownedPetActorIds     Json     @default("[]") @map("owned_pet_actor_ids")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  digest    WclRunSourceDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)
  character Character?         @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([digestId, wclActorId])
  @@index([characterId])
  @@index([blizzardCharacterId])
  @@index([wclCanonicalId])
  @@index([regionCode, realmSlug, characterName])
  @@map("wcl_run_participants")
}

/**
 * Admin-launched Shadow Canary run. Asynchronous; never publishes V1/V2 scores.
 */
model ScoringV2ShadowCanary {
  id                  String    @id @default(uuid()) @db.Uuid
  characterId         String    @map("character_id") @db.Uuid
  regionCode          String    @map("region_code")
  realmSlug           String    @map("realm_slug")
  characterName       String    @map("character_name")
  seasonId            String?   @map("season_id") @db.Uuid
  analysisBatchId     String?   @map("analysis_batch_id") @db.Uuid
  status              String    @default("QUEUED")
  lifecycle           String    @default("SHADOW")
  classSlug           String?   @map("class_slug")
  specSlug            String?   @map("spec_slug")
  role                String?
  specializationId    String?   @map("specialization_id") @db.Uuid
  catalogVersion      String?   @map("catalog_version")
  catalogSupportState String?   @map("catalog_support_state")
  /** Bounded progress + diagnostics (no raw WCL events). */
  progress            Json      @default("{}")
  diagnostics         Json      @default("{}")
  errorCode           String?   @map("error_code")
  errorMessage        String?   @map("error_message")
  requestedByUserId   String    @map("requested_by_user_id") @db.Uuid
  bullmqJobId         String?   @map("bullmq_job_id")
  /** Idempotency key for relaunch coalescing. */
  idempotencyKey      String    @unique @map("idempotency_key")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt           DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  character   Character @relation(fields: [characterId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("ShadowCanaryRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([characterId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([requestedByUserId, createdAt(sort: Desc)])
  @@map("scoring_v2_shadow_canaries")
}
