enum RefreshAdmissionStatus {
  RESERVED
  SETTLED
  RELEASED
  EXPIRED
  CANCELLED
}

/// Durable audit for refresh admission (Redis remains live authority when enforce is on).
/// Foundation/shadow: rows may record predictions; Redis mutation stays off by default.
model RefreshAdmission {
  id                  String                 @id @default(uuid()) @db.Uuid
  jobId               String                 @unique @map("job_id") @db.Uuid
  characterId         String?                @map("character_id") @db.Uuid
  status              RefreshAdmissionStatus
