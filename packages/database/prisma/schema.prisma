  expectedRunCount     Int                     @map("expected_run_count")
  terminalRunCount     Int                     @default(0) @map("terminal_run_count")
  successfulRunCount   Int                     @default(0) @map("successful_run_count")
  unavailableRunCount  Int                     @default(0) @map("unavailable_run_count")
  failedRunCount       Int                     @default(0) @map("failed_run_count")
