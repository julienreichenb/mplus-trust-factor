    "reset:scoring-v2": "tsx src/reset/cli-test-reset.ts",
    "reset:wcl-scoring-derived": "tsx src/reset/cli-wcl-scoring-derived-reset.ts",
    "calibration-labels": "tsx src/reset/cli-calibration-labels.ts"
  },
  "dependencies": {
    "@mplus/artifact-store": "workspace:*",
    "@mplus/contracts": "workspace:*",
    "@prisma/client": "^6.13.0",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@mplus/test-utils": "workspace:*",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
