{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "utility-baseline-diagnostic-v1",
  "title": "UtilityBaselineDiagnostic",
  "type": "object",
  "required": [
    "schemaVersion",
    "analysisVersion",
    "state",
    "fallbackAllowed",
    "publishable",
    "completeZeroContribution"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "analysisVersion": { "const": "utility-baseline-diagnostics-v1" },
    "state": {
      "type": "string",
      "enum": [
        "PUBLISHABLE",
        "COMPLETE_ZERO_CONTRIBUTION",
        "INSUFFICIENT_EVIDENCE_RETRYABLE",
        "WCL_UNAVAILABLE",
        "RATE_LIMITED",
        "BUDGET_EXHAUSTED",
        "NO_PUBLIC_LOGS",
        "IDENTITY_OR_MATCH_FAILURE"
      ]
    },
    "fallbackAllowed": { "type": "boolean" },
    "publishable": { "type": "boolean" },
    "completeZeroContribution": { "type": "boolean" },
    "evidenceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence01": { "type": "number", "minimum": 0, "maximum": 1 },
    "analyzedRunCount": { "type": "integer", "minimum": 0 },
    "compatibleEvidenceCount": { "type": "integer", "minimum": 0 },
    "candidateRunCount": { "type": "integer", "minimum": 0 },
    "observedDomainCount": { "type": "integer", "minimum": 0 },
    "attributableEvents": { "type": "integer", "minimum": 0 },
    "absenceCauses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "no_public_report",
          "report_matching_failed",
          "actor_resolution_failed",
          "event_pagination_truncation",
          "wrong_event_types_queried",
          "unsupported_spell_catalog",
          "truly_zero_observed_contribution",
          "rate_or_budget_stop",
          "cache_incompatibility",
          "incomplete_utility_datasets",
          "survival_only_bundle",
          "unknown"
        ]
      }
    },
    "missingUtilityOnlyDatasets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["HostileCasts", "Interrupts", "Dispels", "DamageDone"]
      }
    },
    "survivalBundleCanSatisfyUtility": { "type": "boolean" },
    "estimatedExtraRunsToPublishable": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 4
    },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "gates": {
      "type": "object",
      "required": [
        "minAnalyzedRuns",
        "minConfidence",
        "minEvidenceCoverage",
        "minObservedDomains"
      ],
      "properties": {
        "minAnalyzedRuns": { "type": "integer" },
        "minConfidence": { "type": "number" },
        "minEvidenceCoverage": { "type": "number" },
        "minObservedDomains": { "type": "integer" }
      }
    },
    "runs": { "type": "array", "items": { "type": "object" } },
    "fallback": {
      "type": "object",
      "properties": {
        "triggered": { "type": "boolean" },
        "selected": { "type": "array" },
        "maxExtraRuns": { "type": "integer", "maximum": 4 }
      }
    }
  }
}
